---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { useTranslations, formatDate, path, type Lang } from '../../../i18n/utils';
import {
  SECTIONS,
  SECTION_META,
  splitId,
  topicSlug,
  readingTime,
  type SectionName,
} from '../../../lib/content';

export async function getStaticPaths() {
  const all = await Promise.all(
    SECTIONS.map(async (section) => {
      const entries = await getCollection(section);
      return entries
        .filter((entry) => !entry.data.draft)
        .map((entry) => {
          const { lang, slug } = splitId(entry.id);
          return {
            params: { lang, section: SECTION_META[section].segment, slug },
            props: { section, entry },
          };
        });
    }),
  );
  return all.flat();
}

const lang = Astro.params.lang as Lang;
const { section, entry } = Astro.props as {
  section: SectionName;
  entry: CollectionEntry<SectionName>;
};
const t = useTranslations(lang);
const { Content } = await render(entry);

// Find the same article in the other languages.
const siblings = (await getCollection(section)).filter(
  (e) => e.data.translationKey === entry.data.translationKey && !e.data.draft,
);
const alternates: Partial<Record<Lang, string>> = {};
for (const sibling of siblings) {
  const { lang: siblingLang, slug } = splitId(sibling.id);
  alternates[siblingLang] = path(siblingLang, SECTION_META[section].segment, slug);
}

const minutes = readingTime(entry.body);
const sectionHref = path(lang, SECTION_META[section].segment);
const activeNav =
  section === 'statements' ? 'statements' : section === 'rights' ? 'rights' : undefined;
---

<Base
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  alternates={alternates}
  active={activeNav}
  publishedTime={entry.data.pubDate}
>
  <article class="card">
    <header class="article-header">
      <p class="kicker">
        <a href={sectionHref}>{t(SECTION_META[section].labelKey)}</a>
      </p>
      <h1>{entry.data.title}</h1>
      <p class="meta">
        {t('meta.publishedOn')}{' '}
        <time datetime={entry.data.pubDate.toISOString()}>
          {formatDate(entry.data.pubDate, lang)}
        </time>
        {entry.data.updatedDate && (
          <>
            {' · '}{t('meta.updatedOn')}{' '}
            <time datetime={entry.data.updatedDate.toISOString()}>
              {formatDate(entry.data.updatedDate, lang)}
            </time>
          </>
        )}
        {' · '}{minutes} {t('meta.readingTime')}
        {entry.data.author && <> · {entry.data.author}</>}
      </p>
    </header>

    {
      !alternates[lang === 'en' ? 'ja' : 'en'] && (
        <p class="notice">{t('empty.translation')}</p>
      )
    }

    {
      entry.data.cover && (
        <img src={entry.data.cover} alt={entry.data.coverAlt ?? ''} width="950" height="500" />
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      entry.data.topics.length > 0 && (
        <section aria-labelledby="article-topics">
          <h2 id="article-topics" class="kicker">{t('meta.topics')}</h2>
          <ul class="topics">
            {entry.data.topics.map((topic) => (
              <li><a class="topic-chip" href={path(lang, 'topics', topicSlug(topic))}>{topic}</a></li>
            ))}
          </ul>
        </section>
      )
    }

    <p style="margin-top:2rem">
      <a class="more" href={sectionHref}>
        ← {t('meta.backTo')} {t(SECTION_META[section].titleKey)}
      </a>
    </p>
  </article>
</Base>
