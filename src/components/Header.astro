---
import Logo from './Logo.astro';
import LangSwitcher from './LangSwitcher.astro';
import { useTranslations, path, type Lang } from '../i18n/utils';
import { SITE } from '../site.config.mjs';

interface Props {
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
  /** Which nav entry is highlighted: 'home' | 'statements' | 'demands' | 'calendar' | 'about'. */
  active?: string;
}
const { lang, alternates, active } = Astro.props;
const t = useTranslations(lang);

const nav = [
  { key: 'home', href: path(lang), label: t('nav.home') },
  { key: 'statements', href: path(lang, 'statements'), label: t('nav.statements') },
  { key: 'demands', href: path(lang, 'demands'), label: t('nav.demands') },
  { key: 'calendar', href: path(lang, 'calendar'), label: t('nav.calendar') },
  { key: 'about', href: path(lang, 'about'), label: t('nav.about') },
];
---

<header class="site-header">
  <div class="header-content">
    <div class="site-title">
      <a href={path(lang)}>
        <Logo />
        <span class="title">{t('site.name')}</span>
      </a>
    </div>
    <div class="header-actions">
      <LangSwitcher lang={lang} alternates={alternates} />
      <a class="btn btn-yellow" href={`mailto:${SITE.email}`}><span>{t('cta.contact')}</span></a>
    </div>
  </div>
</header>

<nav class="site-nav" aria-label={t('nav.menu')}>
  <div class="nav-content">
    {
      nav.map((item) => (
        <a class="nav-link" href={item.href} aria-current={active === item.key ? 'page' : undefined}>
          <span>{item.label}</span>
        </a>
      ))
    }
  </div>
</nav>
