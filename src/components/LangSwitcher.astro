---
import { languages, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Path to the same page in each language. Missing = link to that language's home. */
  alternates: Partial<Record<Lang, string>>;
}
const { lang, alternates } = Astro.props;
const entries = Object.entries(languages) as [Lang, string][];
---

<nav class="lang-switch" aria-label="Language">
  {
    entries.map(([code, label], i) => (
      <>
        {i > 0 && <span class="sep" aria-hidden="true">/</span>}
        <a
          href={alternates[code] ?? `/${code}/`}
          lang={code}
          hreflang={code}
          aria-current={code === lang ? 'true' : undefined}
        >
          {label}
        </a>
      </>
    ))
  }
</nav>
