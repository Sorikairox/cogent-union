---
/**
 * The union's mark: three figures standing together on a yellow line.
 * Kept as chunky geometry on purpose — it has to stay legible at 36px in the
 * header and at 16px as a favicon. Replace public/favicon.svg to match if you
 * change it here.
 */
interface Props {
  class?: string;
  title?: string;
}
const { class: className = 'mark', title = '' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 64 64"
  role={title ? 'img' : 'presentation'}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title || undefined}
  xmlns="http://www.w3.org/2000/svg"
>
  <rect width="64" height="64" fill="#d11a1d"></rect>
  <g fill="#fff">
    <circle cx="14" cy="18" r="6"></circle>
    <rect x="7" y="27" width="14" height="19" rx="3"></rect>
    <circle cx="32" cy="15" r="6"></circle>
    <rect x="25" y="24" width="14" height="22" rx="3"></rect>
    <circle cx="50" cy="18" r="6"></circle>
    <rect x="43" y="27" width="14" height="19" rx="3"></rect>
  </g>
  <rect x="7" y="50" width="50" height="6" fill="#fee901"></rect>
</svg>
