---
/**
 * The union's mark: a C on the union's red, over a yellow line.
 * One thick stroke on purpose — it has to stay legible at 36px in the header
 * and at 16px as a favicon. Keep public/favicon.svg in step with any change.
 */
interface Props {
  class?: string;
  title?: string;
}
const { class: className = 'mark', title = '' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 64 64"
  role={title ? 'img' : 'presentation'}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title || undefined}
  xmlns="http://www.w3.org/2000/svg"
>
  <rect width="64" height="64" fill="#d11a1d"></rect>
  <path d="M46 17a18 18 0 1 0 0 30" fill="none" stroke="#fff" stroke-width="10"></path>
  <rect x="14" y="52" width="36" height="7" fill="#fee901"></rect>
</svg>
